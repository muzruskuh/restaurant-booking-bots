# Токены телеграм-ботов (заполните своими значениями)
BOT_INCOMING_TOKEN=
BOT_OUTGOING_TOKEN=

# Параметры доступа к Supabase
SUPABASE_URL=
ANON_KEY=
APP_PASSWORD=

# Чаты
# CHAT_CURRENT_ID — чат «Общий»: брони на ТЕКУЩУЮ дату (без даты в сообщениях + служебная инфа)
# CHAT_FUTURE_ID   — чат «Брони»: все брони, кроме текущей даты (в сообщениях есть дата)
CHAT_CURRENT_ID=
CHAT_FUTURE_ID=
# Служебный лог-чат: бот-приёмник шлёт сюда результаты броней (Добавлено/Уже есть/Обновлено/Удалено/Ошибка),
# чтобы в чатах с гостями не было служебной переписки. Если не задан — отвечает в исходный чат.
CHAT_LOG_ID=